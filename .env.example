# Public app URL
APP_URL=http://localhost:5176

# Required: strong admin PIN (8+ chars). Never use documented defaults in production.
ADMIN_PIN=

# Local-only fallback if ADMIN_PIN is empty (never set on Render)
# ALLOW_INSECURE_DEFAULT_PIN=1

# Comma-separated CORS origins (default *). For split hosting set explicit origins.
# CORS_ORIGINS=https://ruhitrends.com,https://www.ruhitrends.com,https://ruhi-boutique.onrender.com

# Postgres — Neon Free pooled URL in production (see docs/DATABASE.md)
# Omit for local SQLite under apps/api/data/ruhi.db
# DATABASE_URL=postgresql://ruhi:PASS@ep-xxxx-pooler.region.aws.neon.tech/ruhi?sslmode=require
